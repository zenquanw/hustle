{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "一键推送到 GitHub",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/tools/sync.ps1",
        "-Message", "${input:commitMessage}"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "这次练习做了什么？（直接回车则用时间戳）",
      "default": ""
    }
  ]
}
